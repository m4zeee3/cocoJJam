{
  "expo": {
    "name": "cocoJJAM",
    "slug": "cocojjam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cocojjam",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.cocojjam.app"
    },
    "android": {
      "package": "com.cocojjam.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 112
        }
      ],
      "expo-sqlite",
      "react-native-fast-tflite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "cocoJJAM uses the camera to check how fresh your food is. Photos stay on your phone.",
          "photosPermission": "cocoJJAM reads photos you pick to check how fresh your food is. Photos stay on your phone."
        }
      ],
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1045250307755-iduldkk34c7ku5sp1pd80cmr4bbhm4qv"
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "cocoJJAM uses the camera to check how fresh your food is. Photos stay on your phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "cocoJJAM uses motion to tell you when your phone is steady enough for a sharp photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90eb6f87-d57f-404a-aba5-0499d682e835"
      }
    },
    "owner": "ian_reyes"
  }
}
