# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cocojjam

# OAuth client IDs that may sign in (comma-separated: Android, iOS, web)
GOOGLE_CLIENT_IDS=1045250307755-841e5stdd0uhvjc02dkstrpis74j5hq9.apps.googleusercontent.com,1045250307755-iduldkk34c7ku5sp1pd80cmr4bbhm4qv.apps.googleusercontent.com,1045250307755-08olv63ams1mu4n206levvm9dehdqja8.apps.googleusercontent.com

# Secret for the app's own session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_DAYS=30

# Lets /auth/dev sign in without Google. Never enable in production.
DEV_AUTH=false
